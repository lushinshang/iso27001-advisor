# .gitignore — ISO 27001 Advisor Agent

# ==========================
# 機密檔案（絕不提交）
# ==========================
.env
*.key
*.pem
secrets/

# ==========================
# Python 編譯產物
# ==========================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================
# 測試與覆蓋率產物
# ==========================
.pytest_cache/
.coverage
htmlcov/
.tox/

# ==========================
# 評估結果（可重新產生）
# ==========================
# eval_results.json 若含敏感測試資料可加入；目前保留供版控追蹤
# eval_results.json

# ==========================
# 編輯器 / OS 暫存
# ==========================
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.egg-info/
dist/
build/
outputs/

# ==========================
# 執行期產生的暫存檔（可重建）
# ==========================
tmp/
faq_checkpoint.json
